# Application
APP_NAME=Site-to-Cash
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini API (required starting Phase 3 — set locally in .env, never commit real keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Upload and input size safeguards (bytes / characters)
MAX_DOCUMENT_UPLOAD_BYTES=20971520
MAX_ATTACHMENT_UPLOAD_BYTES=15728640
MAX_INSTRUCTION_TEXT_CHARS=20000

# Storage ("local" for local development; "gcp" planned for Cloud Storage + Firestore)
STORAGE_BACKEND=local
LOCAL_DATA_DIR=data

# Future GCP deployment settings (unused while STORAGE_BACKEND=local)
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
FIRESTORE_DATABASE=(default)
